rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    /** adminEmails in rbac/config must be lowercase strings. */
    function normalizedAuthEmail() {
      return request.auth.token.email.lower();
    }

    function isListedEmailAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/rbac/config)
        && 'adminEmails' in get(/databases/$(database)/documents/rbac/config).data
        && get(/databases/$(database)/documents/rbac/config).data.adminEmails is list
        && normalizedAuthEmail() in get(/databases/$(database)/documents/rbac/config).data.adminEmails;
    }

    function isUidAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return isUidAdmin() || isListedEmailAdmin();
    }

    match /rbac/config {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /admin_data/{document=**} {
      allow read, write: if isAdmin();
    }

    function isValidLyricsPayload(data) {
      return data.keys().hasAll(['title', 'lyrics', 'last-modified', 'last-modified-by'])
        && data.title is string
        && data.lyrics is string
        && data['last-modified'] is string
        && data['last-modified-by'] is string
        && data.title.size() <= 500
        && data.lyrics.size() <= 50000
        && data['last-modified'].size() <= 120
        && data['last-modified-by'].size() <= 320
        && (!('hymn-num' in data) || data['hymn-num'] is string)
        && (!('category' in data) || data.category is list)
        && (!('version' in data) || data.version is string)
        && (!('adapt-of' in data) || data['adapt-of'] is string);
    }

    match /lyrics/{docId} {
      allow read: if true;
      allow create: if isAdmin() && isValidLyricsPayload(request.resource.data);
      allow update: if isAdmin() && isValidLyricsPayload(request.resource.data);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
